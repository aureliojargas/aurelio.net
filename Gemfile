# 2026-09-03
# Hack necessary to be able to install in Crostini (Debian 13.6) in my Chromebook:
#
# sudo apt-get install clang
# mkdir -p /tmp/clang-override
# ln -sf /usr/bin/clang /tmp/clang-override/gcc
# ln -sf /usr/bin/clang /tmp/clang-override/x86_64-linux-gnu-gcc
# ln -sf /usr/bin/clang++ /tmp/clang-override/g++
# ln -sf /usr/bin/clang++ /tmp/clang-override/x86_64-linux-gnu-g++
# PATH="/tmp/clang-override:$PATH" bundle install
